logging {
  level  = "info"
  format = "logfmt"
}

// Discover every container on the host. Filtering happens in the
// discovery.relabel.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Keep-list: only containers labeled eventory.logs=true reach Loki
// (set per service in Compose).
discovery.relabel "keep_list" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_eventory_logs"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  // Loki 3 derives service_name from this label; without it every stream
  // is filed under service_name="unknown_service".
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

// Tails stdout/stderr for kept containers and forwards raw lines to Loki.
// JSON bodies are stored as-is; LogQL `| json` parses fields at query time
// so we never promote high-cardinality fields (request_id, path) to labels.
loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.keep_list.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// App traces: OTLP/HTTP on :4318 (the apps' OTEL_EXPORTER_OTLP_ENDPOINT) -> Tempo.
otelcol.receiver.otlp "apps" {
  grpc {}
  http {}

  output {
    traces = [otelcol.processor.filter.drop_noise.input]
  }
}

// Traefik's Docker provider polls the Docker API every few seconds and each
// call becomes a root trace ("GET /v1.54/containers/..."). Drop those.
otelcol.processor.filter "drop_noise" {
  error_mode = "ignore"

  traces {
    span = ["resource.attributes[\"service.name\"] == \"traefik\" and IsMatch(name, \"^GET /v1[.]\")"]
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
