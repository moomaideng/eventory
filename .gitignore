# Ignore any legacy root environment file. Local configuration lives under
# frontend/ and backend/; each directory tracks only its .env.example.
/.env*

# for dev to put context, temporary file
temp/

# Taskfile
/.task/
.cache/

# k6 raw output; the HTML reports are kept for the write-up
loadtest/results/*
!loadtest/results/*.html
!loadtest/results/.gitkeep
