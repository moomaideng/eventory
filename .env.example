# Local PostgreSQL (used only by docker-compose.yml)
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=app_db
POSTGRES_PORT=5432
# Uses the same credentials above and Docker's `postgres` service hostname.
DB_DSN=postgresql://admin:password123@postgres:5432/app_db?sslmode=disable

# Supabase Auth (safe public browser configuration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# URLs exposed on the host when running Docker Compose
API_URL=http://localhost:8080
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Browser origins allowed to call the backend locally.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
