# Backend runtime
PORT=8080
ENVIRONMENT=development
DB_DSN=postgresql://admin:password123@localhost:5432/app_db?sslmode=disable
SUPABASE_URL=https://your-project.supabase.co
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local PostgreSQL container
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# Optional host port for the backend container
BACKEND_PORT=8080
