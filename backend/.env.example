# HTTP server.
PORT=8080

# Local PostgreSQL connection settings.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=app_db

# Used by the backend when database integration is enabled.
DB_DSN=host=localhost user=admin password=password123 dbname=app_db port=5432 sslmode=disable
