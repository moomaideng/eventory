# Notification service defaults. Retry delays are a project policy, not a RabbitMQ standard.
HTTP_PORT=8084
ENVIRONMENT=development
DB_DSN=postgresql://admin:password123@localhost:5432/notification_db?sslmode=disable
AMQP_URL=amqp://eventory:eventory@localhost:5672/
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@eventory.local
SMTP_FROM_NAME=Eventory
SMTP_STARTTLS=false
SMTP_TIMEOUT=10s
PUBLIC_WEB_URL=http://localhost:3000
RETRY_DELAYS=30s,5m,30m
CONSUMER_PREFETCH=1
PROCESSING_LEASE=20s
BROKER_RECONNECT_DELAY=5s
SUPABASE_URL=https://your-project.supabase.co
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOGGING_LEVEL=
LOGGING_FORMAT=
LOGGING_SLOW_REQUEST_MS=
