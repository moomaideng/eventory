@startuml c4-level2-container
skinparam dpi 200
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title Level 2: Container Diagram - Eventory

Person(organizer, "Organizer", "Hosts and runs tournaments")
Person(competitor, "Competitor / Captain", "Registers solo or with team")
Person(sponsor, "Sponsor", "Funds tournaments via packages")
Person(staff, "Tournament Staff", "Enters match results")

System_Ext(supabase, "Supabase Auth", "Google OAuth and JWT token provider")
System_Ext(s3, "Object Storage", "S3-compatible storage for sponsor logos")
System_Ext(smtp, "SMTP Relay / Mailpit", "Delivers notification emails")

System_Boundary(c1, "Eventory Platform") {
    Container(web_app, "Web Client", "Next.js 16, React", "Browser interface for tournament management, lobbies, and mock checkout")
    Container(gateway, "API Gateway", "Traefik v3", "Edge reverse proxy routing requests and forwarding trace context")

    together {
        Container(account_service, "Account Service", "Go, Huma v2", "Manages user accounts, profiles, and mode switching")
        Container(tournament_service, "Tournament Service", "Go, Huma v2", "Manages tournaments, lobbies, brackets, forms, and sponsorships")
        Container(payment_service, "Payment Service", "Go, Huma v2", "Manages invoices, mock checkout settlement, and PDF receipts")
        Container(notification_service, "Notification Service", "Go, Worker & REST", "Consumes domain events to send emails and in-app notices")
    }

    together {
        ContainerDb(account_db, "Account DB", "PostgreSQL", "Stores user accounts and organizer/sponsor profiles")
        ContainerDb(tournament_db, "Tournament DB", "PostgreSQL", "Stores tournaments, lobbies, and brackets")
        ContainerDb(forms_db, "Forms DB", "MongoDB 7", "Stores custom form schemas and submission data")
        ContainerDb(payment_db, "Payment DB", "PostgreSQL", "Stores invoices and payment ledger")
        Container(broker, "Message Broker", "RabbitMQ", "Exchanges domain events with retries and dead-letter queues")
        ContainerDb(notification_db, "Notification DB", "PostgreSQL", "Stores in-app notices and email delivery logs")
    }

    account_service -[hidden]right- tournament_service
    tournament_service -[hidden]right- payment_service
    payment_service -[hidden]right- notification_service

    account_db -[hidden]right- tournament_db
    tournament_db -[hidden]right- forms_db
    forms_db -[hidden]right- payment_db
    payment_db -[hidden]right- broker
    broker -[hidden]right- notification_db
}

Rel(organizer, web_app, "Uses", "HTTPS")
Rel(competitor, web_app, "Uses", "HTTPS")
Rel(sponsor, web_app, "Uses", "HTTPS")
Rel(staff, web_app, "Uses", "HTTPS")

Rel_R(web_app, supabase, "Authenticates", "HTTPS")
Rel_D(web_app, gateway, "API calls", "HTTPS")

Rel_D(gateway, account_service, "/api/v1/accounts", "HTTP")
Rel_D(gateway, tournament_service, "/api/v1/tournaments, /lobbies", "HTTP")
Rel_D(gateway, payment_service, "/api/v1/payments", "HTTP")
Rel_D(gateway, notification_service, "/api/v1/notifications", "HTTP")

Rel_L(tournament_service, account_service, "Fetches profiles", "gRPC")
Rel_R(tournament_service, payment_service, "Creates and refunds invoices", "gRPC")

Rel_D(account_service, account_db, "Reads/Writes", "SQL")
Rel_D(tournament_service, tournament_db, "Reads/Writes", "SQL")
Rel_D(tournament_service, forms_db, "Reads/Writes", "TCP")
Rel_D(payment_service, payment_db, "Reads/Writes", "SQL")
Rel_D(notification_service, notification_db, "Reads/Writes", "SQL")

Rel_L(tournament_service, s3, "Stores/fetches logos", "HTTPS")

Rel_D(tournament_service, broker, "Publishes events", "AMQP")
Rel_D(payment_service, broker, "Publishes payment.confirmed", "AMQP")
Rel_U(broker, notification_service, "Delivers events", "AMQP")
Rel_R(notification_service, smtp, "Sends emails", "SMTP")

@enduml
