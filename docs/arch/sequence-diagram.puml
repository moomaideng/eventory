@startuml
mainframe sd SubmitRegistration

actor "aCaptain" as captain
participant "__:WebClient__" as client
participant "__:APIGateway__" as gw
participant "__:TournamentService__" as tournament
participant "__:AccountService__" as account
participant "__:PaymentService__" as payment
participant "__:MessageBroker__" as mq
participant "__:NotificationService__" as notif

' Lock roster and create invoice
activate captain
captain -> client ++ : submitRoster()
client -> gw ++ : POST /tournaments/{tournamentId}/teams/{teamId}/lock
gw -> tournament ++ : lockTeamLobby(tournamentId, teamId)
tournament -> account ++ : BatchGetAccounts(captainId)
deactivate account
tournament -> tournament ++ : validateRoster(answers, deadline, teamSize)
deactivate tournament
tournament -> tournament ++ : setStatus(PAYMENT_PENDING)
deactivate tournament
tournament -> payment ++ : CreatePayment(payerId, entryFee, reference)
payment --> tournament -- : invoice(paymentId, UNPAID)
tournament --> gw -- : team(PAYMENT_PENDING, paymentId)
gw --> client -- : team(PAYMENT_PENDING, paymentId)
client --> captain -- : checkout page

' Pay
captain -> client ++ : completePayment(result)
client -> gw ++ : POST /payments/{id}/mock-result
gw -> payment ++ : completeMockPayment(id, result)

alt result = SUCCEEDED
  payment -> payment ++ : setPaidAt(now)
  deactivate payment
  payment --> gw -- : invoice(PAID)
  gw --> client -- : invoice(PAID)
  client --> captain -- : payment succeeded
  activate payment
  payment ->> mq ++ : publish(payment.confirmed)
  deactivate payment
  mq ->> tournament ++ : payment.confirmed
  mq ->> notif ++ : payment.confirmed
  deactivate mq
  notif -> notif ++ : sendPaymentConfirmed(payerId)
  deactivate notif
  deactivate notif
  tournament -> tournament ++ : setStatus(LOCKED)
  deactivate tournament
  tournament ->> mq ++ : publish(registration.submitted)
  deactivate tournament
  mq ->> notif ++ : registration.submitted
  deactivate mq
  notif -> notif ++ : sendRegistrationSubmitted(captainId)
  deactivate notif
  deactivate notif
else result = FAILED or CANCELLED
  activate client
  activate gw
  activate payment
  payment -> payment ++ : setCancelledAt(now)
  deactivate payment
  payment --> gw -- : invoice(CANCELLED)
  gw --> client -- : invoice(CANCELLED)
  client --> captain -- : payment failed, retry allowed
  activate payment
  payment ->> mq ++ : publish(payment.cancelled)
  deactivate payment
  mq ->> tournament ++ : payment.cancelled
  deactivate mq
  tournament -> tournament ++ : clearPaymentAttempt()
  deactivate tournament
  deactivate tournament
  note right of tournament
    Registration not submitted.
    Team stays PAYMENT_PENDING (roster frozen).
    Retry = lock again, which starts a new attempt.
  end note
end

deactivate captain
@enduml
