' PAYMENT SERVICE
' ============================================================================
package "Payment Service" {
  class "Payments" as Payments <<Resource>> {
    + GET()
  }

  class "Payment" as Payment <<Resource>> {
    + GET()
  }

  class "PaymentMockResult" as PaymentMockResult <<Resource>> {
    + POST()
  }

  class "PaymentReceipt" as PaymentReceipt <<Resource>> {
    + GET()
  }

  class "PaymentReceiptPDF" as PaymentReceiptPDF <<Resource>> {
    + GET()
  }

  class "Payment" as Rep_Payment <<Representation>> {
    - id : string
    - payerAccountId : string
    - source : string
    - provider : string
    - reference : string
    - amountMinor : integer
    - currency : string
    - status : string
    - expiresAt : string
    - paidAt : string
  }

  class "Receipt" as Rep_Receipt <<Representation>> {
    - id : string
    - invoiceId : string
    - payerAccountId : string
    - source : string
    - reference : string
    - amountMinor : integer
    - currency : string
    - paidAt : string
  }
}

EventoryAPI .[#B45309].> Payments : <<Path>> /payments
Payments .[#B45309].> Payment : <<Path>> /{id}
