' NOTIFICATION SERVICE
' ============================================================================
package "Notification Service" {
  class "Notifications" as Notifications <<Resource>> {
    + GET()
  }

  class "NotificationsReadAll" as NotificationsReadAll <<Resource>> {
    + PATCH()
  }

  class "NotificationRead" as NotificationRead <<Resource>> {
    + PATCH()
  }

  class "Notification" as Rep_Notification <<Representation>> {
    - id : string
    - userId : string
    - type : string
    - title : string
    - message : string
    - link : string
    - isRead : boolean
    - readAt : string
    - createdAt : string
  }
}

EventoryAPI .[#B45309].> Notifications : <<Path>> /notifications
Notifications .[#B45309].> NotificationsReadAll : <<Path>> /read-all
Notifications .[#B45309].> NotificationRead : <<Path>> /{id}/read

Notifications .[#BE185D].> Rep_Notification : <<use>>
NotificationsReadAll .[#BE185D].> Rep_Notification : <<use>>
NotificationRead .[#BE185D].> Rep_Notification : <<use>>

