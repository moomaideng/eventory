@startuml uml-api-diagram
left to right direction
hide circle
hide empty members
skinparam dpi 200
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 60

skinparam class {
  BackgroundColor<<Application>> #E2E8F0
  BorderColor<<Application>> #334155
  BackgroundColor<<Resource>> #E6F4F4
  BorderColor<<Resource>> #0F766E
  BackgroundColor<<Representation>> #FDF2F8
  BorderColor<<Representation>> #BE185D
  FontColor #0F172A
  AttributeFontSize 11
}

skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  FontColor #334155
}

title Eventory REST API — UML API Diagram (Sparx-style UML Profile)

class "EventoryAPI" as EventoryAPI <<Application>> {
  {field} { basePath = "/api/v1" }
}

note bottom of EventoryAPI
  Each microservice also exposes
  GET /health outside { basePath = "/api/v1" }.
  Protected operations require
  Authorization: Bearer <JWT>.
end note

' ============================================================================
' ACCOUNT SERVICE
' ============================================================================
package "Account Service" {
  class "Accounts" as Accounts <<Resource>> {
    + POST()
  }

  class "Account" as AccountById <<Resource>> {
    + GET()
  }

  class "MyAccount" as MyAccount <<Resource>> {
    + GET()
    + PATCH()
  }

  class "MyOrganizerProfile" as MyOrganizerProfile <<Resource>> {
    + GET()
    + PUT()
  }

  class "MySponsorProfile" as MySponsorProfile <<Resource>> {
    + GET()
    + PUT()
  }

  class "PublicOrganizerProfile" as PublicOrganizerProfile <<Resource>> {
    + GET()
  }

  class "SponsorDirectory" as SponsorDirectory <<Resource>> {
    + GET()
  }

  class "Account" as Rep_Account <<Representation>> {
    - id : string
    - email : string
    - handle : string
    - displayName : string
    - status : string
    - createdAt : string
  }

  class "OrganizerProfile" as Rep_OrganizerProfile <<Representation>> {
    - accountId : string
    - organizerName : string
    - organizerEmail : string
    - phone : string
    - privacyConsentedAt : string
  }

  class "SponsorProfile" as Rep_SponsorProfile <<Representation>> {
    - accountId : string
    - sponsorName : string
    - sponsorEmail : string
    - phone : string
    - websiteUrl : string
    - logoUrl : string
    - tags : string[]
  }
}

EventoryAPI .[#B45309].> Accounts : <<Path>> /accounts
Accounts .[#B45309].> AccountById : <<Path>> /{id}
Accounts .[#B45309].> MyAccount : <<Path>> /me
Accounts .[#B45309].> PublicOrganizerProfile : <<Path>> /organizers/{id}
Accounts .[#B45309].> SponsorDirectory : <<Path>> /sponsors
MyAccount .[#B45309].> MyOrganizerProfile : <<Path>> /organizer-profile
MyAccount .[#B45309].> MySponsorProfile : <<Path>> /sponsor-profile

Accounts .[#BE185D].> Rep_Account : <<use>>
AccountById .[#BE185D].> Rep_Account : <<use>>
MyAccount .[#BE185D].> Rep_Account : <<use>>
MyOrganizerProfile .[#BE185D].> Rep_OrganizerProfile : <<use>>
PublicOrganizerProfile .[#BE185D].> Rep_OrganizerProfile : <<use>>
MySponsorProfile .[#BE185D].> Rep_SponsorProfile : <<use>>
SponsorDirectory .[#BE185D].> Rep_SponsorProfile : <<use>>

